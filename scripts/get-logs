#!/bin/bash
set -Eeo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: $0 <run-id>"
    exit 1
fi

RUN_ID=$1
ARTIFACT_ROOT="${RESEARCH_ARTIFACT_ROOT:-$HOME/research-agent-data/runs}"
RUN_DIR="$ARTIFACT_ROOT/$RUN_ID"

if [ ! -d "$RUN_DIR" ]; then
    echo "Error: Run directory $RUN_DIR does not exist."
    exit 1
fi

echo "--- Logs for run: $RUN_ID ---"
find "$RUN_DIR/artifacts/raw/logs" -maxdepth 1 -type f -print -exec tail -n 50 {} \; 2>/dev/null || echo "No persisted logs found."
