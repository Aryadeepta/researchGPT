#!/bin/bash

# Configuration
PROJECT_DIR="$(dirname "$(realpath "$0")")"
VENV_PATH="$PROJECT_DIR/venv"
QA_SCRIPT="$PROJECT_DIR/qa.py"

# Ensure Virtual Environment exists
if [ ! -d "$VENV_PATH" ]; then
    echo "Error: Virtual environment not found. Please run ./research first."
    exit 1
fi

# Activate VENV and run script
source "$VENV_PATH/bin/activate"
python3 "$QA_SCRIPT" "$@"
