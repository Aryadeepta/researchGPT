#!/bin/bash

# Configuration
PROJECT_DIR="$(dirname "$(realpath "$0")")"
VENV_PATH="$PROJECT_DIR/venv"
MAIN_SCRIPT="$PROJECT_DIR/main.py"
PID_FILE="$PROJECT_DIR/.research.pid"
LOG_FILE="$PROJECT_DIR/research.log"

# Ensure API Key is set
if [ -z "$GOOGLE_API_KEY" ]; then
    echo "Error: GOOGLE_API_KEY environment variable is not set."
    echo "Please run: export GOOGLE_API_KEY='your_key' (add to your .bashrc to make permanent)"
    exit 1
fi

# Ensure Virtual Environment exists and is ready
if [ ! -d "$VENV_PATH" ]; then
    echo "Setting up virtual environment..."
    python3 -m venv "$VENV_PATH"
    "$VENV_PATH/bin/pip" install --upgrade pip
    "$VENV_PATH/bin/pip" uninstall -y google-generativeai
    "$VENV_PATH/bin/pip" install google-genai numpy scipy
fi

# Command Logic
case "$1" in
    start)
        shift
        # Use robust background execution, exporting API key to environment
        echo "Starting research..."
        GOOGLE_API_KEY="$GOOGLE_API_KEY" nohup "$VENV_PATH/bin/python3" "$MAIN_SCRIPT" "$@" > "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        echo "Research started in background (PID: $!). Monitor with './research logs'"
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            kill $(cat "$PID_FILE")
            rm "$PID_FILE"
            echo "Research stopped."
        else
            echo "Research is not running."
        fi
        ;;
    status)
        if [ -f "$PID_FILE" ]; then
            echo "Research is running (PID: $(cat "$PID_FILE"))."
        else
            echo "Research is not running."
        fi
        ;;
    logs)
        tail -f "$LOG_FILE"
        ;;
    *)
        # Foreground run (default)
        source "$VENV_PATH/bin/activate"
        python3 "$MAIN_SCRIPT" "$@"
        ;;
esac
